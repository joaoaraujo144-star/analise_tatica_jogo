# Copia para ".env" (fica fora do git) e preenche com os teus valores.

# Conta já existente na app (treinador/adjunto, membro da equipa) —
# usada só para ler players/wellness_responses via a API pública.
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# id da equipa (teams.id) — vê-se no URL do dashboard depois de abrir a
# equipa, ou corre "select id, nome from teams;" no SQL Editor.
TEAM_ID=

# JID do grupo de WhatsApp (algo como "123456789-1234567890@g.us") —
# corre "npm run list-groups" depois do 1º login para o descobrires.
WHATSAPP_GROUP_JID=

# Opcional — horas de envio (hora de Lisboa), separadas por vírgula.
# Por omissão (se não definires): 10:00,12:30
HORAS_ENVIO=